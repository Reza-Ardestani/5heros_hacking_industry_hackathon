{
  // GitHub Codespaces (free tier, no card): the app starts by itself on port 8080.
  // Switch branch any time from the terminal: bb-start <branch>
  "name": "Bottleneck Busters",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": { "label": "App: UI + API (password)", "onAutoForward": "notify" },
    "8000": { "label": "MCP server", "onAutoForward": "silent" }
  },
  // SUMO's binary links libGL and X libraries even when run headless.
  // bb-start lives outside the repo, so it keeps working after switching to a branch
  // that has no .devcontainer folder.
  "postCreateCommand": "sudo rm -f /etc/apt/sources.list.d/yarn.list && sudo apt-get update -qq && sudo apt-get install -y -qq --no-install-recommends libgl1 libglu1-mesa libxrender1 libxcursor1 libxft2 libxinerama1 libxrandr2 libxi6 libfontconfig1 && pip install --user --quiet uv && install -D -m 755 .devcontainer/bb-start.sh \"$HOME/.local/bin/bb-start\"",
  "postStartCommand": "\"$HOME/.local/bin/bb-start\"",
  "secrets": {
    "BB_AUTH_PASSWORD": {
      "description": "Demo site password (username: bottleneck). Leave empty to have one generated."
    },
    "ELEVENLABS_API_KEY": {
      "description": "Optional. ElevenLabs API key: adds a read-aloud button to chat replies."
    }
  }
}
